# Copiar como .env en la EC2 de mensajeria y completar. El archivo .env NO se sube a Git.
# Lo leen docker-compose.yml (cluster) y docker-compose.prod.yml (microservicios).

# Usuario de RabbitMQ (lo usan tambien ms-requests, notifications y rabbit-admin)
RABBITMQ_USERNAME=barriodigital
RABBITMQ_PASSWORD=cambiar-esta-clave

# Cookie compartida entre los 2 nodos del cluster (cualquier texto largo)
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie-larga
